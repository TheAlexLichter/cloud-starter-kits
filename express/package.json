{
    "name": "express-starter-kit",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/server.ts",
        "start": "node src/server.ts",
        "test": "node --test",
        "lint": "tsc --noEmit && oxlint && oxfmt --check",
        "format": "oxfmt"
    },
    "dependencies": {
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.4",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "typescript": "^6.0.3"
    }
}
